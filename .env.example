# Deployment Environment: staging | production | development
APP_ENV=staging

# JWT Configuration
JWT_SECRET=super-secret-jwt-key-notes-api-32b!
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_HOURS=168

# Elastic APM (traces HTTP, PostgreSQL and Redis in both services)
ELASTIC_APM_SERVER_URL=http://apm-server:8200
ELASTIC_APM_SECRET_TOKEN=

# Host Exposed Ports
NOTES_API_PORT=9933
NOTES_API_GIN_PORT=9944
